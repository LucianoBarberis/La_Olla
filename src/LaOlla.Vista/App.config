<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Demo database. The docente creates it with sql/01_schema_seed.sql and edits Data Source here. -->
    <add name="LaOlla"
         connectionString="Data Source=localhost;Initial Catalog=LaOlla;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
